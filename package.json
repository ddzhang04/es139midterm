{
  "name": "historylens-prototype",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "start:native": "expo start --dev-client",
    "build:ios": "npx eas-cli build --platform ios --profile development",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:android": "npx eas-cli build --platform android --profile development",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "bundle": "expo export --platform ios --platform android",
    "build:ios:simulator": "npx eas-cli build --platform ios --profile simulator",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run format:check",
    "doctor:ios": "node scripts/check-ios-toolchain.mjs",
    "ios:local": "npm run doctor:ios && expo run:ios --device"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/config-plugins": "~57.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@reactvision/react-viro": "2.57.3",
    "expo": "~57.0.0",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-speech": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
